[Unit]
Description=Personio attendance: catch-up after wake-up, and keeping the sign-in alive

# Opening the lid resumes the session rather than logging in, so the login trigger
# doesn't fire. This re-checks every 30 minutes, every day: on working days it logs
# the day if that hasn't happened yet; otherwise it only visits Personio every few
# hours so the sign-in doesn't expire.
[Timer]
OnCalendar=*-*-* 08..20:00/30
Persistent=false

[Install]
WantedBy=timers.target
